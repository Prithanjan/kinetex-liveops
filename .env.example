# Kinetex LiveOps environment
# Copy to .env.local and fill in what you need.

# Source of the event graph: "local" (seeded JSON, offline) or "notion".
KINETEX_SOURCE=local

# Only required when KINETEX_SOURCE=notion.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Optional: label shown on generated summaries. Never claim an LLM call
# that did not happen (see docs/decisions and the Measured-or-Placeholder rule).
KINETEX_SUMMARY_MODE=rules
